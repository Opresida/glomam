# Instagram Graph API — usado por scripts/fetch-instagram.mjs no prebuild
# Sem essas variáveis, o build não quebra: Novidades.jsx faz fallback pro conteúdo estático em src/data/noticias.js
#
# Como obter:
#   1) IG_USER_ID: ID numérico da conta IG Business. Ver README seção "Integração Instagram".
#   2) IG_ACCESS_TOKEN: token long-lived (60 dias) gerado no Meta Business Suite.
#
# Em produção: configurar como env vars no Netlify (Site settings → Environment variables).
IG_USER_ID=
IG_ACCESS_TOKEN=

# Build Hook do Netlify usado pelo botão "Atualizar agora" em /admin/intranet → Imprensa.
# IMPORTANTE: precisa ter o prefixo VITE_ pra Vite expor no client. O URL fica embutido no bundle JS;
# como /admin/intranet ainda não tem auth real, considere isso semi-secreto (max risco: builds desperdiçados).
VITE_NETLIFY_BUILD_HOOK_URL=
